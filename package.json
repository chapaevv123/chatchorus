{
  "name": "chatchorus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.1" },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "node --experimental-strip-types server/index.ts",
    "dev:ui": "vite --host 127.0.0.1 --configLoader runner",
    "start": "node --experimental-strip-types server/index.ts",
    "start:live": "node --env-file=.env --experimental-strip-types server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "build:showcase": "tsc --noEmit && vite build --configLoader runner --mode showcase",
    "preflight:publish": "node scripts/publication_preflight.mjs",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "tsx": "^4.20.3"
  }
}
